// Cloudflare публикует папку public (там готовый сайт index.html).
// Сборка не нужна: index.html уже собран. Имя должно совпадать с проектом в Cloudflare.
{
  "name": "shoh-parfumer",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    // Неверный адрес (например /abc) — страница public/404.html, она сразу открывает главную
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  // Домен сайта: Cloudflare сам создаёт записи DNS и сертификат.
  "routes": [
    { "pattern": "shoh-parfumer.com", "custom_domain": true },
    { "pattern": "www.shoh-parfumer.com", "custom_domain": true }
  ]
}
