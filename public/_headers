# Защита: браузер не угадывает тип файлов, не передаёт полный адрес на чужие сайты, сайт нельзя встроить в чужую страницу,
# только https (HSTS). Не трогает работу сайта.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Фото ароматов: браузер хранит их сутки и не спрашивает сервер при каждом открытии (обновятся в течение дня после замены)
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Шрифты (public/fonts) не меняются — браузер хранит год. Новая версия шрифта = новое имя файла.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
